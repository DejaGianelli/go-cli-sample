# Build output (keep the folder itself via .gitkeep)
build/*
!build/.gitkeep

# Binaries built outside the build folder
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and coverage output
*.test
*.out
coverage.*

# Go workspace file
go.work
go.work.sum

# Environment files
.env

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
